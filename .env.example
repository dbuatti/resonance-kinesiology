# Resonance Kinesiology - Environment Variables
# Copy this to .env.local and fill in your values

# Google Analytics 4 Measurement ID
# Get from: https://analytics.google.com/ -> Admin -> Data Streams -> Web stream details
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console Verification Code
# Get from: https://search.google.com/search-console -> Settings -> Ownership verification -> HTML tag
# The meta tag content value (already in index.html: DYPd1bslXx-JpunG6kS52-jWFOIFa6WxQeh2uSn23KI)
VITE_GSC_VERIFICATION_CODE=DYPd1bslXx-JpunG6kS52-jWFOIFa6WxQeh2uSn23KI

# Site URL (for canonical URLs and structured data)
